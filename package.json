{
  "name": "provenance-investigation-2026-05-19-site",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i src/index.css -o src/index.compiled.css --content 'src/**/*.tsx'",
    "css:watch": "tailwindcss -i src/index.css -o src/index.compiled.css --content 'src/**/*.tsx' --watch",
    "dev": "bun run css && bun --hot index.ts",
    "build": "bun run css && bun build index.html --outdir dist --minify && mkdir -p dist/audit && cp site/index.html dist/audit/index.html"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  }
}
